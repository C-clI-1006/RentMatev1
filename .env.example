# RentMate environment configuration (copy to backend/.env)
# Never commit real values. Secrets belong in .env, not in code or the frontend.

# --- Application ---
# Path to the SQLite database file (relative to backend/ or absolute)
DATABASE_PATH=./rentmate.db

# --- LLM (school Qwen proxy) ---
# Connection details per the course proxy connection guide.
# Maintenance routes unconfigured/unavailable inference to manual review.
# Labelled test doubles are used only when explicitly injected by tests.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# --- Auth (prototype) ---
# Prototype auth context source. The production binding of tenantId<->propertyId
# comes from login/authorisation, never from user input.
AUTH_MODE=prototype
# Server-provisioned session map; replace tokens with random secrets.
# Example shape only; default denies access until configured.
RENTMATE_AUTH_TOKENS={}

# Dedicated secret for POST /api/ops/monthly-reports/run. Ordinary user
# sessions cannot impersonate the trusted scheduler.
RENTMATE_SCHEDULER_TOKEN=
