# RentMate environment configuration (copy to backend/.env)
# Never commit real values. Secrets belong in .env, not in code or the frontend.

# --- Application ---
# Path to the SQLite database file (relative to backend/ or absolute)
DATABASE_PATH=./rentmate.db

# Directory where the evidence module stores uploaded original files
# (relative to backend/ or absolute)
EVIDENCE_STORAGE_ROOT=./evidence_storage

# --- LLM (school Qwen proxy) ---
# Connection details per the course proxy connection guide.
# ONE shared configuration for all model calls: Maintenance priority
# assessment (LlmPriorityAssessor) and Evidence document classification
# (QwenDocumentClassifier) read the same four variables below; each
# module keeps its own existing fail-closed behaviour when they are
# missing or unavailable.
# Labelled test doubles are used only when explicitly injected by tests.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# --- Auth (prototype) ---
# Prototype auth context source. The production binding of tenantId<->propertyId
# comes from login/authorisation, never from user input.
AUTH_MODE=prototype
# Server-provisioned session map; replace tokens with random secrets.
# JSON object: session token -> context. A tenant upload context carries
# "tenant_id" + "property_id"; a manager review context additionally
# carries "manager_id". Example shape only; default denies access until
# configured. Read from the server environment at request time (no
# restart needed when tokens change).
RENTMATE_AUTH_TOKENS={}

# Dedicated Bearer secret for monthly reports, UC4/UC5 checks and notification
# dispatch operations. Ordinary user sessions cannot impersonate the trusted
# scheduler.
RENTMATE_SCHEDULER_TOKEN=
